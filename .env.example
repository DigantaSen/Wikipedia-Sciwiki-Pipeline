# Copy this file to ".env" and fill in your own key.
# Never commit the real ".env" file -- it holds your personal secret.

GEMINI_API_KEY=your-gemini-api-key-here

# Optional: extra keys, comma-separated. When one key's quota runs out,
# 03_translate.py automatically switches to the next. Quotas are per
# Google Cloud PROJECT, so each key must come from a different project.
# GEMINI_API_KEYS=second-key,third-key,fourth-key
